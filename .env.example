# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string — local (mongodb://localhost:27017/quran-khatm)
# or MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/quran-khatm

# Any long, random string — used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session lasts before the token expires
JWT_EXPIRES_IN=30d

# Port the API listens on
PORT=5000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
